# ==============================================================================
# IoT Network Cabinet Monitoring & Ventilation Control - Environment Configuration
# Specification: V1.3 (P0 Priority)
# ==============================================================================

# --- Flask & Application ---
FLASK_ENV=development
FLASK_APP=backend.app:create_app()
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_secure_random_flask_secret_key_in_production

# --- PostgreSQL Database (PostgreSQL 16 / iot_cabinet) ---
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/iot_cabinet
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iot_cabinet
DB_USER=postgres
DB_PASSWORD=postgres123

# --- IAM, JWT & Session Management (Mục 5 & 15.2) ---
# Khóa ký Access JWT
JWT_SECRET_KEY=change_this_to_a_secure_jwt_signing_key_32_bytes_min
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15

# Khóa ký HMAC Double-Submit CSRF Cookie
CSRF_SECRET_KEY=change_this_to_a_secure_csrf_hmac_signing_key

# Khóa băm HMAC cho định danh login_attempts (chống lưu username/IP thô)
AUTH_LOG_HMAC_KEY=change_this_to_a_secure_hmac_key_for_login_logs

# Thời hạn phiên làm việc
SESSION_ABSOLUTE_HOURS=8
SESSION_IDLE_MINUTES=30

# Cấu hình Argon2id băm mật khẩu người dùng (Mục 2 & OWASP)
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- MQTT Broker (Eclipse Mosquitto + Dynamic Security) (Mục 2 & 8) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_TLS_PORT=8883
MQTT_BROKER_USE_TLS=false
MQTT_CA_CERT_PATH=

# Worker Ingestion & Command Dispatch Service Credential
MQTT_WORKER_USERNAME=worker_service
MQTT_WORKER_PASSWORD=worker_service_secret_pass_123
MQTT_WORKER_CLIENT_ID=backend-mqtt-worker

# Broker Controller Credential (quản lý Dynamic Security plugin)
MQTT_CONTROLLER_USERNAME=broker_admin
MQTT_CONTROLLER_PASSWORD=broker_admin_secret_pass_123
MQTT_CONTROLLER_CLIENT_ID=backend-broker-controller

# --- Default Seed Accounts (Mục 6.7) ---
ADMIN_BOOTSTRAP_USERNAME=admin_demo
ADMIN_BOOTSTRAP_PASSWORD=Admin@Cabinet2026!
ADMIN_BOOTSTRAP_FULLNAME=System Administrator

OPERATOR_BOOTSTRAP_USERNAME=operator_demo
OPERATOR_BOOTSTRAP_PASSWORD=Operator@Cabinet2026!
OPERATOR_BOOTSTRAP_FULLNAME=Network Cabinet Operator

VIEWER_BOOTSTRAP_USERNAME=viewer_demo
VIEWER_BOOTSTRAP_PASSWORD=Viewer@Cabinet2026!
VIEWER_BOOTSTRAP_FULLNAME=Auditor Viewer

# --- Web & CORS Allowlist ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Phase Flags ---
# P0: false (chỉ 1 node controller, không đo RPM)
# P1: true (bật node 2 monitor RPM & fan bindings)
FAN_MONITOR_ENABLED=false
